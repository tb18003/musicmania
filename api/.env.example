# Copy to .env (git-ignored) for local runs. In production these come from Secret Manager.
# Local Supabase (cd database && supabase db start) listens on 54322.
DATABASE_URL=jdbc:postgresql://localhost:54322/postgres
DATABASE_USER=musicmania_api
DATABASE_PASSWORD=change-me
# Optional
PORT=8080
