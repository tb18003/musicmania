# Copy to .env.local (git-ignored) for local development. All values are public, not secrets:
# the web client is a PKCE public client, exactly like the Android app.
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/musicmania/auth/callback
# Optional: leave empty to hide the friends ranking.
VITE_MUSICMANIA_API_URL=
